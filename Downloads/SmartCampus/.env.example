# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# Flask session secret - change this to a long random string in production
SECRET_KEY=change-this-to-a-long-random-string

# Used only by seed_admin.py to create the first admin account.
# You can leave these unset and the script will prompt you interactively instead.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rcpit.ac.in
ADMIN_PASSWORD=change-this-password
